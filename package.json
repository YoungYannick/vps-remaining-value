{
  "name": "vps-remaining-value",
  "version": "0.3.6",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "minify:public": "node scripts/build/minify-public.js",
    "build": "npm run minify:public && npx @yao-pkg/pkg . --targets node24-win-x64 --output dist/VPSRemainingValue.exe"
  },
  "dependencies": {
