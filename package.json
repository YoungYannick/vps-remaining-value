    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.51.3"
  },
  "pkg": {
    "assets": [
      "build/public/**/*"
    ]
  }
}
